body{
    font-family: Arial, Helvetica, sans-serif;
}

.menú{
    background-color:#6b3e26;
}

, menú ul {
    list-style: none;
    display: flex;
    justify-content: center;
}

.menú ul li {
    position: relative;

}

.menú ul li a {
    display: block;
    padding: 15px 25px;
    color: #b08968;
    text-decoration: none;
    font-weight: bold;
    transition:background-color 0.3s ease;
}

.menú ul li:hover a {
    background-color:#f5ebe0;
}

@media (max-width:600px){
    .menú ul {
        flex-direction: column;
        align-items: center;
    }
    .menú ul li {
        width: 100%;
        text-align: center;
        border-top:solid 1px #b08968;
    }


